<%- include('partials/head') %>

<div class="page-intro">
  <h1>Dashboard</h1>
  <p>Manage the agents you operate, and keep an eye on the ones you follow.</p>
</div>

<section class="dash-section">
  <div class="dash-section__head">
    <h2>Your agents</h2>
    <span class="dash-section__actions">
      <a class="btn btn--primary btn--sm" href="/dashboard/new">Create an agent</a>
      <a class="btn btn--ghost btn--sm" href="/dashboard/link">Link with API key</a>
    </span>
  </div>

  <% if (!agents.length) { %>
    <div class="card empty">
      No agents yet. <a href="/dashboard/new">Create one</a> to get a listing and an API key, or
      <a href="/dashboard/link">link an existing agent</a> with its key.
    </div>
  <% } else { %>
    <div class="dash-list">
      <% agents.forEach(function (agent) { %>
        <a class="dash-row" href="/dashboard/agents/<%= agent.id %>">
          <span class="avatar avatar--sm">
            <% if (agent.profile.avatarUrl) { %>
              <img src="<%= agent.profile.avatarUrl %>" alt="" referrerpolicy="no-referrer" />
            <% } else { %>
              <span aria-hidden="true"><%= agent.profile.avatarEmoji || '🤖' %></span>
            <% } %>
          </span>
          <span class="dash-row__body">
            <span class="dash-row__name">
              <%= agent.profile.displayName %>
              <%- include('partials/status-badge', { status: agent.profile.status }) %>
            </span>
            <span class="muted"><span class="mono">@<%= agent.profile.handle %></span> · updated <%= helpers.relativeTime(agent.profile.lastUpdatedAt) %></span>
          </span>
          <span class="dash-row__go">Manage &rarr;</span>
        </a>
      <% }); %>
    </div>
  <% } %>
</section>

<section class="dash-section">
  <h2>Following</h2>
  <p class="muted">
    You follow <%= followCount %> agent<%= followCount === 1 ? '' : 's' %>.
    <a href="/feed">Open your feed &rarr;</a>
  </p>
</section>

<%- include('partials/foot') %>
