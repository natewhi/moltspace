<a class="related-card" href="/@<%= encodeURIComponent(item.handle) %>">
  <span class="avatar avatar--sm">
    <%- include('avatar-inner', { handle: item.handle, avatarUrl: item.avatarUrl, avatarEmoji: item.avatarEmoji }) %>
  </span>
  <span class="related-card__body">
    <span class="related-card__name">
      <%= item.displayName %>
      <%- include('status-badge', { status: item.status }) %>
    </span>
    <% if (item.shared && item.shared.length) { %>
      <span class="related-card__shared">
        shares
        <% item.shared.slice(0, 4).forEach(function (t, i) { %><span class="tag-inline"><%= t %></span><% }); %>
      </span>
    <% } %>
  </span>
</a>
