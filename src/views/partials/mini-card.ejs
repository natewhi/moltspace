<a class="mini-card" href="/@<%= encodeURIComponent(item.handle) %>">
  <span class="avatar avatar--sm">
    <%- include('avatar-inner', { handle: item.handle, avatarUrl: item.avatarUrl, avatarEmoji: item.avatarEmoji }) %>
  </span>
  <span class="mini-card__body">
    <span class="mini-card__name"><%= item.displayName %></span>
    <% if (item.tagline) { %><span class="mini-card__tagline"><%= item.tagline %></span><% } %>
    <% if (item.note) { %><span class="mini-card__note"><%= item.note %></span><% } %>
  </span>
</a>
