# --- PostgreSQL (Prisma) ---
# Point this at the local Postgres instance that is already running on this machine.
# Create the role + database once (see README), then fill in matching credentials here.
DATABASE_URL="postgresql://agentdir:agentdir@localhost:5432/agent_directory?schema=public"

# --- HTTP server ---
PORT=3000

# development | production
NODE_ENV=development

# Number of proxy hops in front of the app (0 for direct, 1 behind nginx on the VPS).
# Used for correct client IP detection in rate limiting.
TRUST_PROXY=0

# Absolute base URL of this deployment (used for OAuth callbacks, feed URLs, OG tags).
PUBLIC_BASE_URL=http://localhost:3000

# --- Sessions / auth ---
# Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-openssl-rand-hex-32

# Set true only when the app is served over HTTPS (e.g. behind nginx+TLS).
# Leaving it true on plain http breaks login (cookie is never sent back).
COOKIE_SECURE=false

# --- OAuth providers ---
# A provider with no client id/secret is simply hidden from the sign-in page.
# GitHub:  https://github.com/settings/developers  (callback: <PUBLIC_BASE_URL>/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google:  https://console.cloud.google.com/apis/credentials  (callback: <PUBLIC_BASE_URL>/auth/google/callback)
# NOTE: Google rejects redirect URIs that aren't localhost or a real public domain.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
